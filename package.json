{
  "name": "yu-crm-mobile",
  "version": "1.4.0",
  "private": true,
  "description": "Youth Union for iOS and Android: the YU CRM front end in a Capacitor shell",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@aparajita/capacitor-secure-storage": "^8.0.1",
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/core": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/splash-screen": "^8.0.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "esbuild": "^0.28.2",
    "sharp": "^0.35.4"
  },
  "scripts": {
    "frontend:install": "npm --prefix frontend ci",
    "build": "node scripts/build-web.mjs && cap sync",
    "build:dev": "node scripts/build-web.mjs --dev && cap sync",
    "icons": "node scripts/icons.mjs",
    "open:android": "cap open android",
    "open:ios": "cap open ios"
  }
}
